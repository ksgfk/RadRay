{
    "version": 10,
    "configurePresets": [
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CONFIGURATION_TYPES": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CONFIGURATION_TYPES": "Release"
            }
        },
        {
            "name": "win-x64",
            "hidden": true,
            "environment": {
                "PATH": "${sourceDir}/SDKs/radray_dxc/extracted/bin;$penv{PATH}"
            },
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "RADRAY_DEPENDENCY_TRIPLET": "windows-x64-msvc",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "win-x64-clangcl",
            "hidden": true,
            "environment": {
                "PATH": "${sourceDir}/SDKs/radray_dxc/extracted/bin;$penv{PATH}"
            },
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "ClangCL",
                "strategy": "set"
            },
            "cacheVariables": {
                "RADRAY_DEPENDENCY_TRIPLET": "windows-x64-clangcl",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "macos-arm64",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "RADRAY_DEPENDENCY_TRIPLET": "macos-arm64-appleclang"
            }
        },
        {
            "name": "win-x64-debug",
            "inherits": [
                "debug",
                "win-x64"
            ],
            "binaryDir": "${sourceDir}/build/windows-x64-msvc/Debug"
        },
        {
            "name": "win-x64-release",
            "inherits": [
                "release",
                "win-x64"
            ],
            "binaryDir": "${sourceDir}/build/windows-x64-msvc/Release"
        },
        {
            "name": "win-x64-debug-clangcl",
            "inherits": [
                "debug",
                "win-x64-clangcl"
            ],
            "binaryDir": "${sourceDir}/build/windows-x64-clangcl/Debug"
        },
        {
            "name": "win-x64-release-clangcl",
            "inherits": [
                "release",
                "win-x64-clangcl"
            ],
            "binaryDir": "${sourceDir}/build/windows-x64-clangcl/Release"
        },
        {
            "name": "macos-arm64-debug",
            "inherits": [
                "debug",
                "macos-arm64"
            ],
            "binaryDir": "${sourceDir}/build/macos-arm64-appleclang/Debug"
        },
        {
            "name": "macos-arm64-release",
            "inherits": [
                "release",
                "macos-arm64"
            ],
            "binaryDir": "${sourceDir}/build/macos-arm64-appleclang/Release"
        }
    ],
    "buildPresets": [
        {
            "name": "win-x64-debug",
            "configurePreset": "win-x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "win-x64-release",
            "configurePreset": "win-x64-release",
            "configuration": "Release"
        },
        {
            "name": "win-x64-debug-clangcl",
            "configurePreset": "win-x64-debug-clangcl",
            "configuration": "Debug"
        },
        {
            "name": "win-x64-release-clangcl",
            "configurePreset": "win-x64-release-clangcl",
            "configuration": "Release"
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug",
            "configuration": "Debug"
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "win-x64-debug",
            "configurePreset": "win-x64-debug",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-x64-release",
            "configurePreset": "win-x64-release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-x64-debug-clangcl",
            "configurePreset": "win-x64-debug-clangcl",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-x64-release-clangcl",
            "configurePreset": "win-x64-release-clangcl",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
