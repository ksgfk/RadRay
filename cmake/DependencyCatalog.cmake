# Dependency contract: docs/guide/build-test.md.
file(READ "${CMAKE_CURRENT_LIST_DIR}/DependencyCatalog.json" RADRAY_DEPENDENCY_CATALOG)
string(JSON _radray_count LENGTH "${RADRAY_DEPENDENCY_CATALOG}")
math(EXPR _radray_last "${_radray_count} - 1")
set(RADRAY_DEPENDENCIES "")
foreach(index RANGE ${_radray_last})
    string(JSON entry GET "${RADRAY_DEPENDENCY_CATALOG}" ${index})
    string(JSON name GET "${entry}" name)
    foreach(field package component mode)
        string(JSON RADRAY_DEP_${name}_${field} GET "${entry}" ${field})
    endforeach()
    set(RADRAY_DEP_${name}_targets "")
    string(JSON count LENGTH "${entry}" targets)
    math(EXPR last "${count} - 1")
    foreach(item RANGE ${last})
        string(JSON value GET "${entry}" targets ${item})
        list(APPEND RADRAY_DEP_${name}_targets "${value}")
    endforeach()
    string(JSON condition GET "${entry}" when)
    separate_arguments(condition UNIX_COMMAND "${condition}")
    if (${condition})
        list(APPEND RADRAY_DEPENDENCIES "${name}")
    endif()
endforeach()
