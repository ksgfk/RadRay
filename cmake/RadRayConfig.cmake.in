@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/RadRayPackageChecks.cmake")
set(RadRay_AVAILABLE_COMPONENTS "@RADRAY_AVAILABLE_COMPONENTS@")
set_and_check(RadRay_SHADERLIB_DIR "@PACKAGE_RADRAY_SHADERLIB_INSTALL_DIR@")
set(_radray_package_dir "${CMAKE_CURRENT_LIST_DIR}")
set(RadRay_FOUND TRUE)

function(_radray_load_component component)
    set(RadRay_${component}_FOUND FALSE PARENT_SCOPE)
    set(RadRay_NOT_FOUND_MESSAGE "RadRay component '${component}' or one of its dependencies is unavailable" PARENT_SCOPE)
    # Let the outer component check decide whether a missing dependency is fatal.
    # find_dependency must not turn an OPTIONAL_COMPONENT into a required package.
    set(RadRay_FIND_REQUIRED FALSE)
    if (NOT component IN_LIST RadRay_AVAILABLE_COMPONENTS)
        set(RadRay_NOT_FOUND_MESSAGE "RadRay component '${component}' is not installed; available: ${RadRay_AVAILABLE_COMPONENTS}" PARENT_SCOPE)
        return()
    endif()
    set(prerequisites "")
    if (component MATCHES "^(shader|window|render)$")
        set(prerequisites core)
    elseif(component STREQUAL "runtime")
        set(prerequisites render)
    elseif(component STREQUAL "shadercompiler")
        set(prerequisites shader)
    elseif(component STREQUAL "tools")
        set(prerequisites shadercompiler)
    endif()
    foreach(required IN LISTS prerequisites)
        _radray_load_component(${required})
        if (NOT RadRay_${required}_FOUND)
            set(RadRay_NOT_FOUND_MESSAGE "RadRay ${component} requires unavailable ${required}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(VOLK_PULL_IN_VULKAN OFF)
    if (component STREQUAL "core")
@RADRAY_FIND_core@
    elseif(component STREQUAL "render")
@RADRAY_FIND_render@
    elseif(component STREQUAL "shadercompiler")
@RADRAY_FIND_shadercompiler@
        if (RADRAY_DXC_ROOT)
            list(PREPEND CMAKE_PREFIX_PATH "${RADRAY_DXC_ROOT}")
        endif()
        find_dependency(RadRayDXC CONFIG COMPONENTS Headers Compiler)
        radray_check_dxc_package()
    endif()
    include("${_radray_package_dir}/RadRay-${component}-targets.cmake")
    if (NOT component STREQUAL "tools")
        get_target_property(installed RadRay::${component} IMPORTED_CONFIGURATIONS)
        foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE)
            string(TOUPPER "${config}" upper)
            get_property(has_mapping TARGET RadRay::${component} PROPERTY MAP_IMPORTED_CONFIG_${upper} SET)
            if (NOT upper IN_LIST installed AND NOT has_mapping)
                set(RadRay_NOT_FOUND_MESSAGE "RadRay ${component} has no ${config} library. Install that configuration or explicitly set CMAKE_MAP_IMPORTED_CONFIG_${upper}." PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endif()
    set(RadRay_${component}_FOUND TRUE PARENT_SCOPE)
endfunction()

if (NOT RadRay_FIND_COMPONENTS)
    set(RadRay_FIND_COMPONENTS "${RadRay_AVAILABLE_COMPONENTS}")
    foreach(component IN LISTS RadRay_FIND_COMPONENTS)
        set(RadRay_FIND_REQUIRED_${component} TRUE)
    endforeach()
endif()
foreach(component IN LISTS RadRay_FIND_COMPONENTS)
    _radray_load_component(${component})
endforeach()
check_required_components(RadRay)
