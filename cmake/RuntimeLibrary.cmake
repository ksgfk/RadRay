include_guard(GLOBAL)

# Repository triplets describe both the compiler and the CRT ABI of prepared packages.
function(radray_check_repository_crt triplet)
    if (NOT triplet MATCHES "^windows-")
        return()
    endif()
    if (triplet MATCHES "-staticcrt$")
        set(expected "MultiThreaded")
        set(per_config "MultiThreaded")
    else()
        set(expected "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
        if (CMAKE_BUILD_TYPE STREQUAL "Debug")
            set(per_config "MultiThreadedDebugDLL")
        else()
            set(per_config "MultiThreadedDLL")
        endif()
    endif()
    if (DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
        set(actual "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    else()
        set(actual "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
    if (NOT actual STREQUAL expected AND NOT actual STREQUAL per_config)
        message(FATAL_ERROR
            "${triplet} requires CMAKE_MSVC_RUNTIME_LIBRARY=${expected}; got '${actual}'. "
            "Use matching presets and separately prepared packages. Static CRT triplets use /MT even in Debug.")
    endif()
endfunction()
