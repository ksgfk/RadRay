# 编译配置项
include(CMakeDependentOption)
option(RADRAY_BUILD_TESTS "Build the RadRay tests" ${RadRay_IS_TOP_LEVEL})
option(RADRAY_BUILD_BENCHMARKS "Build the RadRay benchmarks" ${RadRay_IS_TOP_LEVEL})
option(RADRAY_BUILD_COMPILE_COMMANDS "Provide the RadRay compile database helper" ${RadRay_IS_TOP_LEVEL})
option(RADRAY_ENABLE_MIMALLOC "Enable mimalloc as allocator" ON)
option(RADRAY_ENABLE_PROFILER "Build with the Tracy profiler client (on-demand; idle until a viewer connects)" ON)
option(RADRAY_ENABLE_ZLIB "Enable zlib support" ON)
cmake_dependent_option(RADRAY_ENABLE_LIBPNG "Enable libpng support" ON "RADRAY_ENABLE_ZLIB" OFF)
option(RADRAY_ENABLE_LIBJPEG "Enable IJG libjpeg support" ON)
option(RADRAY_BUILD_WINDOW "Build the RadRay window" ON)
option(RADRAY_BUILD_RENDER "Build the RadRay render" ON)
cmake_dependent_option(RADRAY_ENABLE_D3D12 "Enable Direct3D 12 backend" ON "RADRAY_BUILD_RENDER AND WIN32" OFF)
cmake_dependent_option(RADRAY_ENABLE_VULKAN "Enable Vulkan backend" ON "RADRAY_BUILD_RENDER" OFF)
option(RADRAY_BUILD_SHADER_COMPILER "Enable RadRay DXC fork compiler capability" ON)
cmake_dependent_option(RADRAY_BUILD_SHADER_TOOLS "Build RadRay shader command line tools" ${RadRay_IS_TOP_LEVEL} "RADRAY_BUILD_SHADER_COMPILER" OFF)

option(RADRAY_INSTALL "Install RadRay libraries and package" OFF)
set(_radray_auto_optimization_default OFF)
if (RadRay_IS_TOP_LEVEL AND NOT RADRAY_INSTALL)
    set(_radray_auto_optimization_default ON)
endif()
option(RADRAY_ENABLE_AUTO_OPTIMIZATION "Add automatic SIMD/FMA/IPO optimization" ${_radray_auto_optimization_default})
set(RADRAY_DEPENDENCY_TRIPLET "" CACHE STRING "Use manually prepared dependencies for this repository triplet")
set(RADRAY_DXC_ROOT "" CACHE PATH "Optional RadRay DXC fork package hint")
