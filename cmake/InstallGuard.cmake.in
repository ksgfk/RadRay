set(identity_file "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@RADRAY_INSTALL_CMAKEDIR@/RadRay-install-identity.txt")
if (EXISTS "${identity_file}")
    file(READ "${identity_file}" previous)
    if (NOT previous STREQUAL "@RADRAY_INSTALL_IDENTITY@")
        message(FATAL_ERROR "Incompatible RadRay source/toolchain/ABI/features/layout in this installation prefix; choose a separate prefix")
    endif()
endif()
get_filename_component(identity_dir "${identity_file}" DIRECTORY)
file(MAKE_DIRECTORY "${identity_dir}")
file(WRITE "${identity_file}" "@RADRAY_INSTALL_IDENTITY@")
