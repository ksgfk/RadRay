include_guard(GLOBAL)
function(radray_check_package_targets package)
    foreach(target IN LISTS ARGN)
        if (NOT TARGET "${target}")
            message(FATAL_ERROR "${package} does not provide required target ${target}. Prepare compatible packages with tools/build_third_party.py.")
        endif()
        get_target_property(configurations "${target}" IMPORTED_CONFIGURATIONS)
        if (configurations AND CMAKE_BUILD_TYPE)
            string(TOUPPER "${CMAKE_BUILD_TYPE}" requested)
            get_property(has_mapping TARGET "${target}" PROPERTY MAP_IMPORTED_CONFIG_${requested} SET)
            if (NOT requested IN_LIST configurations AND NOT "NOCONFIG" IN_LIST configurations AND NOT has_mapping)
                message(FATAL_ERROR "${package}: ${target} has no ${CMAKE_BUILD_TYPE} configuration; prepare it explicitly or supply a compatible CMAKE_MAP_IMPORTED_CONFIG_${requested}")
            endif()
        endif()
        if (WIN32 AND target STREQUAL "spdlog::spdlog")
            get_target_property(definitions "${target}" INTERFACE_COMPILE_DEFINITIONS)
            if (NOT "SPDLOG_WCHAR_TO_UTF8_SUPPORT" IN_LIST definitions)
                message(FATAL_ERROR "RadRay requires spdlog built with SPDLOG_WCHAR_SUPPORT=ON on Windows")
            endif()
        endif()
    endforeach()
endfunction()

function(radray_check_dxc_package)
    if (NOT RadRayDXC_VERSION STREQUAL "1.9.2609.radray.1")
        message(FATAL_ERROR "RadRay requires DXC fork 1.9.2609.radray.1; found '${RadRayDXC_VERSION}'. Run python tools/fetch_sdks.py restore.")
    endif()
    radray_check_package_targets(RadRayDXC RadRayDXC::Headers RadRayDXC::Compiler RadRayDXC::Validator)
    foreach(target RadRayDXC::Compiler RadRayDXC::Validator)
        get_target_property(runtime "${target}" IMPORTED_LOCATION)
        if (NOT EXISTS "${runtime}")
            message(FATAL_ERROR "RadRayDXC runtime is missing: ${runtime}")
        endif()
    endforeach()
endfunction()
