+void RasterDraw::SharedSamplerDefaults(bool arrays) {
+    ASSERT_TRUE(Program(true, false, false, false, false, false, false, arrays));
+    shader::WireMetadataEnvelope envelope{};
+    std::memcpy(&envelope, Metadata.data(), sizeof(envelope));
+    auto artifact = render::CreateBackendShaderArtifact(*Gpu->GetDevice(), Metadata, {Backend() == render::RenderBackend::Vulkan ? shader::ShaderTarget::SPIRV : shader::ShaderTarget::DXIL, envelope.GpuArtifact});
+    ASSERT_TRUE(artifact);
+    MaterialBindingProbe counts;
+    MaterialProbeDevice device{Gpu->GetDevice(), counts};
+    RenderSystem renderer{&device};
+    ASSERT_TRUE(renderer.OnInitialize());
+    ShaderProgram program{&device, std::move(*artifact), nullptr, {}, nullptr, {}, nullptr, {}};
+    auto view = Gpu->GetDevice()->CreateTextureView({Color.get(), render::TextureDimension::Dim2D, render::TextureFormat::RGBA8_UNORM, {0, 1, 0, 1}, render::TextureViewUsage::Resource});
+    ASSERT_TRUE(view);
+    auto defaults = Material(&program, true, false, arrays);
+    defaults.Textures = {view.Get(), view.Get()};
+    const render::SamplerDescriptor nearest{render::AddressMode::ClampToEdge, render::AddressMode::ClampToEdge, render::AddressMode::ClampToEdge,
+                                            render::FilterMode::Nearest, render::FilterMode::Nearest, render::FilterMode::Nearest, 0, 1};
+    auto linear = nearest;
+    linear.MinFilter = linear.MagFilter = render::FilterMode::Linear;
+    defaults.Samplers = {nearest, nearest};
+    vector<MaterialRenderData> versions(4096, defaults);
+    vector<unique_ptr<MaterialGpuState>> owners;
+    owners.reserve(versions.size());
+    radray::RasterDraw otherCore;
+    GpuFrameResources resources{&device};
+    Nullable<render::ShaderParameterSet*> shared{nullptr};
+    const array<float, 4> camera{.5f, 0, 0, 0};
+    const std::span<const byte> views[]{std::as_bytes(std::span{camera})};
+    const auto samplerGroup = [](const PreparedRasterMaterial& material) -> Nullable<render::ShaderParameterSet*> {
+        const auto group = std::find_if(material.Groups.begin(), material.Groups.end(), [](const auto& entry) { return entry.Index == 1; });
+        EXPECT_NE(group, material.Groups.end());
+        if (group == material.Groups.end()) return nullptr;
+        return group->Parameters;
+    };
+    for (uint32_t frame = 0; frame < 3; ++frame) {
+        Begin(frame);
+        resources.BeginEpoch();
+        auto native = MakePipelineContext(renderer, *Frame);
+        PipelineContext context{renderer, native.Frame, native.Commands, resources};
+        if (frame == 0) {
+            for (size_t index = 0; index < versions.size(); ++index) {
+                auto& data = versions[index];
+                if (index % 2) std::reverse(data.Passes[0].Inputs.begin(), data.Passes[0].Inputs.end());
+                auto& core = index % 2 ? otherCore : Core;
+                auto plan = core.ResolveMaterial(renderer, data.Passes[0]);
+                ASSERT_TRUE(plan);
+                owners.push_back(make_unique<MaterialGpuState>());
+                auto prepared = core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{data, *owners.back()}, {.Views = views});
+                ASSERT_TRUE(prepared) << "material " << index;
+                const auto parameters = samplerGroup(*prepared);
+                ASSERT_TRUE(parameters);
+                if (!shared) shared = parameters;
+                EXPECT_EQ(parameters.Get(), shared.Get());
+            }
+        } else {
+            auto plan = Core.ResolveMaterial(renderer, versions[0].Passes[0]);
+            ASSERT_TRUE(plan);
+            for (uint32_t viewIndex = 0; viewIndex < 3; ++viewIndex) {
+                auto prepared = Core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{versions[0], *owners[0]}, {.Views = views});
+                ASSERT_TRUE(prepared);
+                EXPECT_EQ(samplerGroup(*prepared).Get(), shared.Get());
+            }
+        }
+        EXPECT_EQ(counts.Groups[1].Created, 1u);
+        EXPECT_EQ(counts.Groups[1].Set, 2u);
+        EXPECT_EQ(counts.Groups[1].Flush, 1u);
+        EXPECT_EQ(counts.Groups[1].Live, 1u);
+        if (frame == 2) {
+            auto variant = defaults;
+            variant.Samplers[1] = linear;
+            MaterialGpuState variantOwner;
+            auto plan = Core.ResolveMaterial(renderer, variant.Passes[0]);
+            ASSERT_TRUE(plan);
+            auto changed = Core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{variant, variantOwner}, {.Views = views});
+            ASSERT_TRUE(changed);
+            EXPECT_NE(samplerGroup(*changed).Get(), shared.Get());
+            auto remapped = variant;
+            remapped.Samplers = {linear, nearest};
+            MaterialGpuState remappedOwner;
+            auto different = Core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{remapped, remappedOwner}, {.Views = views});
+            ASSERT_TRUE(different);
+            EXPECT_NE(samplerGroup(*different).Get(), samplerGroup(*changed).Get());
+            EXPECT_NE(samplerGroup(*different).Get(), shared.Get());
+            auto invalid = defaults;
+            invalid.Samplers.pop_back();
+            MaterialGpuState invalidOwner;
+            EXPECT_FALSE(Core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{invalid, invalidOwner}, {.Views = views}));
+            auto offset = defaults;
+            offset.Samplers.insert(offset.Samplers.begin(), linear);
+            for (auto& input : offset.Passes[0].Inputs)
+                if (input.Source == MaterialInputSource::Sampler) ++input.ValueIndex;
+            MaterialGpuState offsetOwner;
+            auto offsetPlan = Core.ResolveMaterial(renderer, offset.Passes[0]);
+            ASSERT_TRUE(offsetPlan);
+            auto sameValues = Core.PrepareMaterial(context, *offsetPlan.Get(), MaterialBindingView{offset, offsetOwner}, {.Views = views});
+            ASSERT_TRUE(sameValues);
+            EXPECT_EQ(samplerGroup(*sameValues).Get(), shared.Get());
+            EXPECT_EQ(counts.Groups[1].Created, 3u);
+            RenderSystem other{&device};
+            ASSERT_TRUE(other.OnInitialize());
+            auto foreign = defaults;
+            MaterialGpuState foreignOwner;
+            auto foreignPlan = otherCore.ResolveMaterial(other, foreign.Passes[0]);
+            ASSERT_TRUE(foreignPlan);
+            GpuFrameResources foreignResources{&device};
+            foreignResources.BeginEpoch();
+            PipelineContext foreignContext{other, native.Frame, native.Commands, foreignResources};
+            auto separated = otherCore.PrepareMaterial(foreignContext, *foreignPlan.Get(), MaterialBindingView{foreign, foreignOwner}, {.Views = views});
+            ASSERT_TRUE(separated);
+            EXPECT_NE(samplerGroup(*separated).Get(), shared.Get());
+            EXPECT_EQ(counts.Groups[1].Created, 4u);
+            foreignResources.SealEpoch();
+        }
+        resources.SealEpoch();
+        Complete();
+        resources.CompleteEpoch();
+    }
+    EXPECT_EQ(counts.Groups[1].Live, 1u);
+    Begin();
+    Frame->RetainGpuForFrameRT(std::move(owners.back()));
+    owners.clear();
+    EXPECT_EQ(counts.Groups[1].Live, 1u);
+    Complete();
+    EXPECT_EQ(counts.Groups[1].Live, 0u);
+    Begin();
+    resources.BeginEpoch();
+    auto native = MakePipelineContext(renderer, *Frame);
+    PipelineContext context{renderer, native.Frame, native.Commands, resources};
+    auto plan = Core.ResolveMaterial(renderer, versions[0].Passes[0]);
+    ASSERT_TRUE(plan);
+    auto owner = make_unique<MaterialGpuState>();
+    auto rebuilt = Core.PrepareMaterial(context, *plan.Get(), MaterialBindingView{versions[0], *owner}, {.Views = views});
+    ASSERT_TRUE(rebuilt);
+    EXPECT_EQ(counts.Groups[1].Created, 5u);
+    EXPECT_EQ(counts.Groups[1].Live, 1u);
+    resources.SealEpoch();
+    Complete();
+    resources.CompleteEpoch();
+    owner.reset();
+    EXPECT_EQ(counts.Groups[1].Live, 0u);
+}
+TEST_F(RasterDraw, ImmutableSamplerDefaultsShareAcross4096VersionsAndFlights) { SharedSamplerDefaults(false); }
