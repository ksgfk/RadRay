+#include <radray/hash.h>
 #include <radray/logger.h>
 
 namespace radray {
@@ -11,6 +13,7 @@ RenderSystem::RenderSystem(render::Device* device, std::filesystem::path shaderS
 RenderSystem::~RenderSystem() noexcept { OnShutdown(); }
 void RenderSystem::OnShutdown() noexcept {
     if (_generation) _generation->Alive = false;
+    _immutableSamplerParameters.clear();
     _persistentConstants.reset();
     _graphicsPipelines.reset();
     _shaderCache.reset();
@@ -36,4 +39,32 @@ size_t RenderSystem::GetShaderProgramCacheSize() const noexcept { return _shader
 size_t RenderSystem::GetShaderArtifactCacheSize() const noexcept { return _shaderCache ? _shaderCache->GetArtifactCount() : 0; }
 bool RenderSystem::InvalidateShaderSource(std::string_view sourceName) { return _shaderCache && _shaderCache->InvalidateSource(sourceName); }
 
+size_t RenderSystem::SamplerParametersKeyHash::operator()(const SamplerParametersKey& key) const noexcept {
+    HashCode hash;
+    hash.Add(std::hash<render::PipelineLayout*>{}(key.Layout));
+    hash.Add(key.Group);
+    for (const auto& binding : key.Bindings) {
+        hash.Add(binding.ArrayElement);
+        hash.Add(std::hash<render::Sampler*>{}(binding.Value));
+    }
+    return hash.ToHashCode();
+}
+Nullable<shared_ptr<render::ShaderParameterSet>> RenderSystem::GetOrCreateImmutableSamplerParameters(
+    render::PipelineLayout* layout, uint32_t group, std::span<const ImmutableSamplerBinding> bindings) {
+    if (!_generation || !_generation->Alive || bindings.empty()) return nullptr;
+    SamplerParametersKey key{layout, group, {bindings.begin(), bindings.end()}};
+    if (const auto found = _immutableSamplerParameters.find(key); found != _immutableSamplerParameters.end()) {
+        if (auto parameters = found->second.lock()) return parameters;
+    }
+    std::erase_if(_immutableSamplerParameters, [](const auto& entry) { return entry.second.expired(); });
+    auto created = _device->CreateShaderParameterSet({layout, group});
+    if (!created) return nullptr;
+    for (const auto& binding : bindings)
+        if (!created->Set(binding.Binding, binding.ArrayElement, binding.Value)) return nullptr;
+    if (!created->FlushWrites()) return nullptr;
+    shared_ptr<render::ShaderParameterSet> parameters{created.Release()};
+    _immutableSamplerParameters.emplace(std::move(key), parameters);
+    return parameters;
+}
+
 }  // namespace radray
